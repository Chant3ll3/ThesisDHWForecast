# ── Full post-training pipeline ─────────────────────────────────────
#
#   1. model_inference.py      - forecast chains (GPU)
#   2. results_analysis.py     - SST skill metrics and plots
#   3. ConcatChains_DHW01.py   - destandardise, add trend, build SST files
#   4. Correct_CalcDHW.py      - DHW / HotSpot products
#   5. Correct_PlotDHW.py      - DHW metrics, PDF and CSV
#
# Each step only runs if the previous one finished without an error.
# Submit:  qsub run_full_pipeline.pbs

# set -o pipefail   # (not -e/-u: conda's activate scripts trip on those)

# ---- Environment -------------------------------------------------------

source /g/data/um09/xl5758/miniforge3/etc/profile.d/conda.sh
conda activate /scratch/um09/xl5758/envs/comp-py310

cp ~/DHW-project/*py  /scratch/um09/xl5758/DHW-project
cd /scratch/um09/xl5758/DHW-project

mkdir -p logs results

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "=== Full pipeline ==="
echo "Start  : $(date)"
echo "Node   : $(hostname)"
echo "Python : $(which python)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""

# ---- Run the steps in order ----------------------------------------------

run_step () {
    local script="$1"
    echo "────────────────────────────────────────────────────────────"
    echo ">>> ${script}   started $(date '+%H:%M:%S')"
    echo "────────────────────────────────────────────────────────────"
    local t0=$SECONDS

    python "${script}"
    local status=$?

    local mins=$(( (SECONDS - t0) / 60 ))
    local secs=$(( (SECONDS - t0) % 60 ))
    if [ ${status} -ne 0 ]; then
        echo ""
        echo "!!! ${script} FAILED (exit code ${status}) after ${mins}m ${secs}s"
        echo "!!! Stopping: later steps were NOT run."
        echo "End: $(date)"
        exit ${status}
    fi
    echo ""
    echo ">>> ${script}   finished OK in ${mins}m ${secs}s"
    echo ""
}

run_step model_inference.py
run_step results_analysis.py
run_step ConcatChains_DHW01.py
run_step Correct_CalcDHW.py
run_step Correct_PlotDHW.py

echo ""
echo "End: $(date)"
echo "=== Full pipeline complete ==="