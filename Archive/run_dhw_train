#!/bin/bash
#PBS -q gpuvolta
#PBS -P um09
#PBS -l ngpus=4
#PBS -l ncpus=48
#PBS -l mem=384GB
#PBS -l jobfs=100GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/ia39+scratch/ue12+scratch/um09+gdata/um09
#PBS -l wd
#PBS -j oe

# ── Phase 2: Distributed Model Training ─────────────────────────────
#
# This script supports multi-GPU on a single node AND multi-node
# training.  Adjust the PBS directives to match your allocation.
#
# Single node, 4 GPUs:
#   #PBS -l ngpus=4
#   #PBS -l ncpus=48
#   #PBS -l mem=192GB
#
# Two nodes, 4 GPUs each (8 total):
#   #PBS -l ngpus=8
#   #PBS -l ncpus=96
#   #PBS -l mem=384GB
#
# Submit:  qsub 
# ---- Environment -------------------------------------------------------


# Activate environment
source ~/.bashrc
conda activate /g/data/um09/jt9268/envs/lema-py311

cp ~/DHW-project/*py  /scratch/um09/jt9268/DHW-project
cd /scratch/um09/jt9268/DHW-project

mkdir -p logs checkpoints results

# ── Detect node topology ─────────────────────────────────────────────

# Number of GPUs per node on Gadi gpuvolta
GPUS_PER_NODE=4

# Get list of unique nodes from PBS
NODES=( $(sort -u "$PBS_NODEFILE") )
NNODES=${#NODES[@]}
TOTAL_GPUS=$(( NNODES * GPUS_PER_NODE ))

# Master node is the first in the allocation
MASTER_ADDR=${NODES[0]}
MASTER_PORT=29500

echo "=== Distributed Training ==="
echo "Start     : $(date)"
echo "Nodes     : ${NNODES} — ${NODES[*]}"
echo "GPUs/node : ${GPUS_PER_NODE}"
echo "Total GPUs: ${TOTAL_GPUS}"
echo "Master    : ${MASTER_ADDR}:${MASTER_PORT}"
echo ""
# ── NCCL tuning for Gadi InfiniBand ──────────────────────────────────

export NCCL_DEBUG=INFO
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=ib0
export NCCL_IB_HCA=mlx5

# Avoid fragmentation warnings
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ── Launch options ───────────────────────────────────────────────────

if [ "${NNODES}" -eq 1 ]; then
    # ── Single-node multi-GPU ────────────────────────────────────
    echo "Launching single-node with torchrun (${GPUS_PER_NODE} GPUs)"
    torchrun \
        --standalone \
        --nproc_per_node=${GPUS_PER_NODE} \
        model_training.py

else
    # ── Multi-node multi-GPU ─────────────────────────────────────
    echo "Launching multi-node with torchrun via pbsdsh"

    # Export for sub-processes
    export MASTER_ADDR MASTER_PORT GPUS_PER_NODE NNODES

    # Launch torchrun on each node via PBS's pbsdsh
    # Each node gets a unique NODE_RANK
    NODE_RANK=0
    for NODE in "${NODES[@]}"; do
        echo "  Node ${NODE_RANK}: ${NODE}"
        pbsdsh -n $(( NODE_RANK * GPUS_PER_NODE )) -- bash -c "
            source ~/.bashrc
            conda activate /g/data/um09/jt9268/envs/lema-py311

            #module load python3/3.11.7 cuda/12.3.2 nccl/2.21.5

            export MASTER_ADDR=${MASTER_ADDR}
            export MASTER_PORT=${MASTER_PORT}
            export NCCL_DEBUG=INFO
            export NCCL_IB_DISABLE=0
            export NCCL_SOCKET_IFNAME=ib0
            export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

            torchrun \
                --nnodes=${NNODES} \
                --nproc_per_node=${GPUS_PER_NODE} \
                --node_rank=${NODE_RANK} \
                --master_addr=${MASTER_ADDR} \
                --master_port=${MASTER_PORT} \
                model_training.py
        " &
        NODE_RANK=$(( NODE_RANK + 1 ))
    done

    # Wait for all background jobs
    wait
fi

echo ""
echo "End: $(date)"
echo "=== Training complete ==="

